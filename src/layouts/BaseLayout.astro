---
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ko';
}

const { title = "유승호", description = "클라우드 아키텍트, DevOps 엔지니어, AI 솔루션 전문가", lang = 'ko' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        background-color: #fff;
        color: #333;
        line-height: 1.6;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background-color: #0f172a;
          color: #e2e8f0;
        }
      }

      main {
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      button {
        cursor: pointer;
        border: none;
        background: none;
        font-family: inherit;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      .prose {
        max-width: 65ch;
      }

      h1, h2, h3, h4, h5, h6 {
        line-height: 1.2;
        margin-bottom: 0.5em;
      }

      p {
        margin-bottom: 1em;
      }

      ul, ol {
        margin-left: 1.5em;
        margin-bottom: 1em;
      }

      li {
        margin-bottom: 0.5em;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
