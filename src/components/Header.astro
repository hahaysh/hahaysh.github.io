---
import { siteConfig } from '../lib/data';

interface Props {
  currentPage?: string;
  lang?: 'en' | 'ko';
}

const { currentPage = '', lang = 'en' } = Astro.props;

const navItems = lang === 'ko' ? [
  { label: '홈', href: '/ko/' },
  { label: '소개', href: '/ko/about' },
  { label: '전문성', href: '/ko/expertise' },
  { label: '교육', href: '/ko/training' },
  { label: '포트폴리오', href: '/ko/portfolio' },
  { label: '인증', href: '/ko/certifications' },
  { label: '연락처', href: '/ko/contact' },
] : [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Expertise', href: '/expertise' },
  { label: 'Training', href: '/training' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Certifications', href: '/certifications' },
  { label: 'Contact', href: '/contact' },
];

// Language switcher link
const otherLangLink = lang === 'ko' 
  ? currentPage.replace('/ko/', '/') || '/'
  : currentPage ? `/ko${currentPage}` : '/ko/';
const otherLangLabel = lang === 'ko' ? 'English' : '한국어';
---

<header class="header">
  <div class="container">
    <div class="header-content">
      <a href={lang === 'ko' ? '/ko/' : '/'} class="logo">
        <h1>{siteConfig.name}</h1>
      </a>
      <nav class="nav">
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={item.href} class={currentPage === item.href ? 'active' : ''}>
                {item.label}
              </a>
            </li>
          ))}
          <li class="lang-switcher">
            <a href={otherLangLink} class="lang-link" title={`Switch to ${otherLangLabel}`}>
              {otherLangLabel}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid #e5e7eb;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
  }

  @media (prefers-color-scheme: dark) {
    .header {
      border-bottom-color: #334155;
      background: rgba(15, 23, 42, 0.95);
    }
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .logo h1 {
    font-size: 1.25rem;
    margin: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
  }

  .nav a {
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .nav a:hover {
    text-decoration: none;
    color: #0066cc;
  }

  @media (prefers-color-scheme: dark) {
    .nav a:hover {
      color: #60a5fa;
    }
  }

  .nav a.active {
    color: #0066cc;
    border-bottom: 2px solid #0066cc;
    padding-bottom: 0.25rem;
  }

  @media (prefers-color-scheme: dark) {
    .nav a.active {
      color: #60a5fa;
      border-bottom-color: #60a5fa;
    }
  }

  .lang-switcher {
    margin-left: 1rem;
    border-left: 1px solid #e5e7eb;
    padding-left: 1rem;
  }

  @media (prefers-color-scheme: dark) {
    .lang-switcher {
      border-left-color: #334155;
    }
  }

  .lang-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #666;
    background-color: #f0f0f0;
    padding: 0.4rem 0.8rem;
    border-radius: 0.3rem;
    transition: all 0.2s;
  }

  .lang-link:hover {
    background-color: #e0e0e0;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .lang-link {
      color: #ccc;
      background-color: #333;
    }

    .lang-link:hover {
      background-color: #444;
      color: #f0f0f0;
    }
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      gap: 1rem;
    }

    .nav ul {
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }

    .lang-switcher {
      margin-left: 0;
      border-left: none;
      padding-left: 0;
    }
  }
</style>
