---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, year, client, teamSize, technologies, achievements } = project.data;
---

<BaseLayout title={`${title} - 유성호`} description={description}>
  <Header currentPage="/ko/portfolio" lang="ko" />
  <main>
    <article class="project-detail">
      <div class="container">
        <header class="project-header">
          <h1>{title}</h1>
          <div class="project-meta">
            <span class="meta-item">
              <strong>클라이언트:</strong> {client}
            </span>
            <span class="meta-item">
              <strong>연도:</strong> {year}
            </span>
            <span class="meta-item">
              <strong>팀 규모:</strong> {teamSize}
            </span>
          </div>
        </header>

        <div class="project-content">
          <section class="overview">
            <h2>프로젝트 개요</h2>
            <p>{description}</p>
          </section>

          {technologies && technologies.length > 0 && (
            <section class="technologies">
              <h2>기술 스택</h2>
              <div class="tech-list">
                {technologies.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </section>
          )}

          {achievements && achievements.length > 0 && (
            <section class="achievements">
              <h2>주요 성과</h2>
              <ul class="achievement-list">
                {achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </section>
          )}

          <div class="project-navigation">
            <a href="/ko/portfolio" class="back-link">← 포트폴리오로 돌아가기</a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .project-detail {
    padding: 3rem 0;
  }

  .project-header {
    margin-bottom: 3rem;
  }

  .project-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .project-header h1 {
      font-size: 2rem;
    }
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    font-size: 0.95rem;
    color: #666;
  }

  @media (prefers-color-scheme: dark) {
    .project-meta {
      color: #cbd5e1;
    }
  }

  .meta-item {
    display: flex;
    gap: 0.5rem;
  }

  .meta-item strong {
    color: #0066cc;
  }

  @media (prefers-color-scheme: dark) {
    .meta-item strong {
      color: #60a5fa;
    }
  }

  .project-content {
    max-width: 65ch;
    line-height: 1.8;
  }

  .project-content section {
    margin-bottom: 3rem;
  }

  .project-content h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #0066cc;
  }

  @media (prefers-color-scheme: dark) {
    .project-content h2 {
      color: #60a5fa;
    }
  }

  .project-content p {
    margin-bottom: 1rem;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .project-content p {
      color: #e0e0e0;
    }
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tech-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: #e8f4f8;
    color: #0066cc;
    border-radius: 0.3rem;
    font-size: 0.9rem;
  }

  @media (prefers-color-scheme: dark) {
    .tech-tag {
      background-color: #1a3a42;
      color: #60a5fa;
    }
  }

  .achievement-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .achievement-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .achievement-list li {
      color: #e0e0e0;
    }
  }

  .achievement-list li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #0066cc;
    font-weight: bold;
  }

  @media (prefers-color-scheme: dark) {
    .achievement-list li:before {
      color: #60a5fa;
    }
  }

  .project-navigation {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  @media (prefers-color-scheme: dark) {
    .project-navigation {
      border-top-color: #334155;
    }
  }

  .back-link {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  @media (prefers-color-scheme: dark) {
    .back-link {
      color: #60a5fa;
    }
  }

  .back-link:hover {
    color: #0052a3;
  }

  @media (prefers-color-scheme: dark) {
    .back-link:hover {
      color: #93c5fd;
    }
  }
</style>
