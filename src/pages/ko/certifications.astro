---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { certifications, otherCertifications, awards } from '../../lib/data';

const activeCerts = certifications.filter((c) => c.status === 'active');
const legacyCerts = certifications.filter((c) => c.status === 'legacy');
---

<BaseLayout title="인증 - 유성호" description="Microsoft Azure 및 AI 인증">
  <Header currentPage="/ko/certifications" lang="ko" />
  <main>
    <section class="certs-section">
      <div class="container">
        <h1>인증</h1>
        <p class="intro">Microsoft Learn 프로필의 활성 Microsoft 인증.</p>

        <div class="cert-grid">
          {activeCerts.map((cert) => (
            <div class="cert-card">
              {cert.badgeUrl ? (
                <img src={cert.badgeUrl} alt={cert.title} class="cert-badge" />
              ) : cert.badge ? (
                <div class="cert-icon">{cert.badge}</div>
              ) : (
                <div class="cert-icon">🏆</div>
              )}
              <h3>{cert.title}</h3>
              {cert.note && <p class="cert-note">{cert.note}</p>}
            </div>
          ))}
        </div>

        <h2 class="section-heading">레거시 인증</h2>
        <p class="note">이전에 획득했으며 최신 버전으로 대체된 인증입니다.</p>
        <div class="cert-grid">
          {legacyCerts.map((cert) => (
            <div class="cert-card legacy">
              <div class="cert-icon">📜</div>
              <h3>{cert.title}</h3>
            </div>
          ))}
        </div>

        <h2 class="section-heading">기타 전문 자격증</h2>
        <div class="cert-grid">
          {otherCertifications.map((cert) => (
            <div class="cert-card">
              <div class="cert-icon">🎓</div>
              <h3>{cert.title}</h3>
              {cert.organization && <p class="cert-org">{cert.organization}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="awards-section">
      <div class="container">
        <h2>상장 및 인정</h2>
        <div class="awards-grid">
          {awards.map((award) => (
            <div class="award-card">
              <h3>{award.title}</h3>
              <p class="award-period">{award.period}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .certs-section {
    padding: 3rem 0;
  }

  .certs-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .certs-section h1 {
      font-size: 2rem;
    }
  }

  .intro {
    font-size: 1rem;
    color: #666;
    margin-bottom: 2rem;
  }

  @media (prefers-color-scheme: dark) {
    .intro {
      color: #cbd5e1;
    }
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .cert-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1.5rem;
    }
  }

  .cert-card {
    text-align: center;
    padding: 1.5rem;
    background: #f9fafb;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s;
  }

  @media (prefers-color-scheme: dark) {
    .cert-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .cert-card:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  @media (prefers-color-scheme: dark) {
    .cert-card:hover {
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    }
  }

  .cert-badge {
    width: 120px;
    height: 120px;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .cert-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .cert-card h3 {
    font-size: 0.95rem;
    margin: 0.5rem 0;
    line-height: 1.4;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .cert-card h3 {
      color: #f0f0f0;
    }
  }

  .cert-note {
    font-size: 0.8rem;
    color: #666;
    margin-top: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .cert-note {
      color: #999;
    }
  }

  .cert-org {
    font-size: 0.8rem;
    color: #666;
    margin-top: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .cert-org {
      color: #999;
    }
  }

  .cert-card.legacy {
    opacity: 0.7;
  }

  .section-heading {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .section-heading {
      color: #f0f0f0;
    }
  }

  .note {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .note {
      color: #999;
    }
  }

  .awards-section {
    padding: 3rem 0;
    border-top: 1px solid #e5e7eb;
  }

  @media (prefers-color-scheme: dark) {
    .awards-section {
      border-top-color: #334155;
    }
  }

  .awards-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .award-card {
    padding: 1.5rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
  }

  @media (prefers-color-scheme: dark) {
    .award-card {
      background: #1e293b;
      border-color: #334155;
      border-left-color: #60a5fa;
    }
  }

  .award-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    color: #333;
  }

  @media (prefers-color-scheme: dark) {
    .award-card h3 {
      color: #f0f0f0;
    }
  }

  .award-period {
    font-size: 0.85rem;
    color: #666;
    margin: 0;
  }

  @media (prefers-color-scheme: dark) {
    .award-period {
      color: #999;
    }
  }
</style>
