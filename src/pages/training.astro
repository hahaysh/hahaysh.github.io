---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { trainingTracks, trainingClients, communityActivities, trainingByYear } from '../lib/data';
---

<BaseLayout title="Microsoft 교육 - 유승호" description="2019년부터 Azure, AI, GitHub, Copilot 교육을 제공하는 Microsoft 인증 교육자">
  <Header currentPage="/training" lang="ko" />
  <main>
    <section class="training-section">
      <div class="container">
        <h1>Microsoft 교육</h1>
        <p class="intro">2019년 11월 Microsoft 인증 교육자(MCT)로 입사한 이후, Azure와 AI 교과과정에 걸쳐 엔터프라이즈 팀들을 대상으로 272회 이상의 교육 세션을 진행했습니다.</p>

        <div class="year-grid">
          {trainingByYear.map((yr) => (
            <div class="year-card">
              <div class="year-num">{yr.year}{yr.inProgress ? ' (진행 중)' : ''}</div>
              <div class="year-sessions">{yr.sessions} 세션</div>
              <div class="year-courses">{yr.courses.join(', ')}</div>
            </div>
          ))}
        </div>

        <div class="tracks-grid">
          {trainingTracks.map((track) => (
            <div class="track-card">
              <div class="icon">{track.icon}</div>
              <h2>{track.title}</h2>
              <p class="description">{track.description}</p>
              <div class="exam-codes">
                {track.examCodes.map((code) => (
                  <span class="exam-tag">{code}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="clients-section">
      <div class="container">
        <h2>교육을 받은 엔터프라이즈 고객사</h2>
        <p class="note">Microsoft 입사 이후 다음 조직의 팀들을 대상으로 교육 진행:</p>
        <div class="clients-grid">
          {trainingClients.map((client) => (
            <span class="client-badge">{client}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="community-section">
      <div class="container">
        <h2>커뮤니티 활동</h2>
        <div class="community-grid">
          {communityActivities.map((activity) => (
            <div class="community-card">
              <h3>{activity.title}</h3>
              <p>{activity.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer lang="ko" />
</BaseLayout>

<style>
  .training-section {
    padding: 3rem 0;
  }

  .training-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .training-section h1 {
      font-size: 2rem;
    }
  }

  .intro {
    font-size: 1.1rem;
    color: #666;
    max-width: 65ch;
    margin-bottom: 3rem;
    line-height: 1.8;
  }

  @media (prefers-color-scheme: dark) {
    .intro {
      color: #cbd5e1;
    }
  }

  .year-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .year-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.25rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    .year-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .year-num {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .year-sessions {
    color: #0066cc;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .year-sessions {
      color: #60a5fa;
    }
  }

  .year-courses {
    font-size: 0.75rem;
    color: #666;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .year-courses {
      color: #94a3b8;
    }
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .track-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 2rem;
    transition: all 0.3s;
  }

  @media (prefers-color-scheme: dark) {
    .track-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .track-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  @media (prefers-color-scheme: dark) {
    .track-card:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }
  }

  .icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .track-card h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .description {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  @media (prefers-color-scheme: dark) {
    .description {
      color: #cbd5e1;
    }
  }

  .exam-codes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exam-tag {
    display: inline-block;
    background: white;
    border: 1px solid #e5e7eb;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #0066cc;
  }

  @media (prefers-color-scheme: dark) {
    .exam-tag {
      background: #334155;
      border-color: #475569;
      color: #60a5fa;
    }
  }

  .clients-section {
    padding: 3rem 0;
    border-top: 1px solid #e5e7eb;
  }

  @media (prefers-color-scheme: dark) {
    .clients-section {
      border-top-color: #334155;
    }
  }

  .clients-section h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .note {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .note {
      color: #cbd5e1;
    }
  }

  .clients-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .client-badge {
    display: inline-block;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 0.6rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  @media (prefers-color-scheme: dark) {
    .client-badge {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .community-section {
    padding: 3rem 0;
    border-top: 1px solid #e5e7eb;
  }

  @media (prefers-color-scheme: dark) {
    .community-section {
      border-top-color: #334155;
    }
  }

  .community-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .community-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .community-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .community-card h3 {
    color: #0066cc;
    margin-bottom: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .community-card h3 {
      color: #60a5fa;
    }
  }

  .community-card p {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (prefers-color-scheme: dark) {
    .community-card p {
      color: #cbd5e1;
    }
  }
</style>
