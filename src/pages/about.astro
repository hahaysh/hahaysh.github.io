---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, bio, stats, certifications } from '../lib/data';
---

<BaseLayout title="About - SungHo You" description="Learn more about my background and experience">
  <Header currentPage="/about" />
  <main>
    <section class="about-hero">
      <div class="container">
        <h1>About Me</h1>
        <div class="about-content">
          <div class="about-text">
            <h2>Professional Journey</h2>
            <p>{bio.long}</p>
            
            <h2>Core Focus Areas</h2>
            <ul class="focus-areas">
              <li><strong>Cloud Architecture:</strong> Designing scalable, secure Azure infrastructure for enterprise transformation</li>
              <li><strong>DevOps & Automation:</strong> Building CI/CD pipelines and infrastructure-as-code solutions that accelerate time-to-value</li>
              <li><strong>AI & Intelligent Agents:</strong> Leveraging AI models and LLMs to create intelligent solutions</li>
              <li><strong>Technical Training:</strong> Educating teams through hands-on labs and comprehensive curriculum development</li>
            </ul>

            <h2>By The Numbers</h2>
            <div class="stats-display">
              {stats.map((stat) => (
                <div class="stat">
                  <div class="stat-num">{stat.value}</div>
                  <div class="stat-desc">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>

          <aside class="about-sidebar">
            <img src="/images/profile/sungo-you.jpg" alt={siteConfig.name} class="profile-image" />
            <div class="contact-card">
              <h3>Let's Connect</h3>
              <p>Interested in discussing cloud architecture, AI solutions, or training initiatives?</p>
              <a href={`mailto:${siteConfig.email}`} class="btn">Email Me</a>
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">LinkedIn</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="certifications-section">
      <div class="container">
        <h2>Certifications & Credentials</h2>
        <div class="cert-grid">
          {certifications.map((cert) => (
            <div class="cert-card">
              <div class="cert-icon">🏆</div>
              <h3>{cert.title}</h3>
              <p class="cert-issuer">{cert.code}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-hero {
    padding: 3rem 0;
  }

  .about-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .about-hero h1 {
      font-size: 2rem;
    }
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
    }
  }

  .about-text h2 {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
  }

  .about-text h2:first-child {
    margin-top: 0;
  }

  .about-text p {
    color: #666;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    white-space: pre-wrap;
  }

  @media (prefers-color-scheme: dark) {
    .about-text p {
      color: #cbd5e1;
    }
  }

  .focus-areas {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  .focus-areas li {
    padding: 1rem;
    margin-bottom: 0.5rem;
    background: #f9fafb;
    border-left: 4px solid #0066cc;
    border-radius: 4px;
    color: #666;
    line-height: 1.6;
  }

  @media (prefers-color-scheme: dark) {
    .focus-areas li {
      background: #1e293b;
      border-left-color: #3b82f6;
      color: #cbd5e1;
    }
  }

  .focus-areas strong {
    color: #1f2937;
  }

  @media (prefers-color-scheme: dark) {
    .focus-areas strong {
      color: #e2e8f0;
    }
  }

  .stats-display {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    background: #f9fafb;
    padding: 2rem;
    border-radius: 8px;
  }

  @media (prefers-color-scheme: dark) {
    .stats-display {
      background: #1e293b;
    }
  }

  .stat {
    text-align: center;
  }

  .stat-num {
    font-size: 2rem;
    font-weight: bold;
    color: #0066cc;
    margin-bottom: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .stat-num {
      color: #60a5fa;
    }
  }

  .stat-desc {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.4;
  }

  @media (prefers-color-scheme: dark) {
    .stat-desc {
      color: #cbd5e1;
    }
  }

  .about-sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .profile-image {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  @media (prefers-color-scheme: dark) {
    .profile-image {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }
  }

  .contact-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    .contact-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .contact-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .contact-card p {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .contact-card p {
      color: #cbd5e1;
    }
  }

  .btn {
    display: block;
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s;
    background: #0066cc;
    color: white;
  }

  .btn:hover {
    background: #0052a3;
  }

  @media (prefers-color-scheme: dark) {
    .btn {
      background: #3b82f6;
    }

    .btn:hover {
      background: #2563eb;
    }
  }

  .btn-secondary {
    background: transparent;
    color: #0066cc;
    border: 2px solid #0066cc;
  }

  .btn-secondary:hover {
    background: #0066cc;
    color: white;
  }

  @media (prefers-color-scheme: dark) {
    .btn-secondary {
      color: #60a5fa;
      border-color: #60a5fa;
    }

    .btn-secondary:hover {
      background: #3b82f6;
      color: white;
    }
  }

  .certifications-section {
    padding: 3rem 0;
    border-top: 1px solid #e5e7eb;
  }

  @media (prefers-color-scheme: dark) {
    .certifications-section {
      border-top-color: #334155;
    }
  }

  .certifications-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .cert-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    .cert-card {
      background: #1e293b;
      border-color: #334155;
    }
  }

  .cert-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cert-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 1rem;
  }

  @media (prefers-color-scheme: dark) {
    .cert-issuer {
      color: #94a3b8;
    }
  }

  .verify-link {
    display: inline-block;
    color: #0066cc;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (prefers-color-scheme: dark) {
    .verify-link {
      color: #60a5fa;
    }
  }

  .verify-link:hover {
    text-decoration: underline;
  }
</style>
